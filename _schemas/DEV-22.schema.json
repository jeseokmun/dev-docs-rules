      ],
      "min_rows": 1
    },
    {
      "id": "인수_조건",
      "label": "＊ 인수 조건",
      "type": "table",
      "columns": [
        "ID",
        "조건",
        "검증"
      ],
      "min_rows": 1
    },
    {
      "id": "통과_실패",
      "label": "＊ 통과 / 실패",
      "type": "table",
      "columns": [
        "결과",
        "기준"
      ],
      "min_rows": 1
    }
  ],
  "optional": [
