{
  "code": "DEV-28",
  "title": "UI문구명세서",
  "path_pattern": "{docs_root}/DEV-28-UI문구명세서/DEV-28-{슬러그}.md",
  "single_file": false,
  "required": [
    {
      "id": "톤",
