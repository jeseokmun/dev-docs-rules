      "type": "string",
      "min": 1
    },
    {
      "id": "문구",
      "label": "＊ 문구",
      "type": "table",
      "columns": [
        "키",
        "KO문구",
        "비고"
      ],
      "min_rows": 1
    },
    {
      "id": "금지",
      "label": "＊ 금지",
      "type": "table",
      "columns": [
        "금지",
        "이유"
      ],
      "min_rows": 1
    }
  ],
  "optional": [
    {
      "id": "i18n",
      "label": "○ i18n",
      "type": "table",
      "columns": [
        "항목",
        "규칙"
      ]
    },
    {
      "id": "관련_문서",
      "label": "○ 관련 문서",
      "type": "table",
      "columns": [
        "코드",
        "경로"
      ]
    }
  ],
  "meta": [
    "상태",
    "코드",
    "마지막 갱신",
    "범위",
    "비범위"
  ],
  "open_items": {
    "id": "open",
    "label": "미결",
    "type": "table",
    "columns": [
      "ID",
      "미결",
      "다음에 할 일"
    ]
  },
  "rules": [
    "empty_required_becomes_open_item",
    "no_fake_fill",
    "json_ephemeral_md_ssot"
  ]
}
