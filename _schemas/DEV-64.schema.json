{
  "code": "DEV-64",
  "title": "위험및기술부채목록",
  "path_pattern": "{docs_root}/DEV-64-위험및기술부채목록.md",
  "single_file": true,
  "required": [
    {
      "id": "항목",
      "label": "＊ 항목",
      "type": "table",
      "columns": [
        "항목",
        "종류",
        "영향",
        "갚는 조건"
      ],
      "column_keys": {
        "종류": [
          "위험",
          "기술부채"
        ]
      },
      "min_rows": 1
    }
  ],
  "optional": [
    {
      "id": "관련_문서",
      "label": "○ 관련 문서",
      "type": "table",
      "columns": [
        "코드",
        "경로"
      ]
    }
  ],
  "meta": [
    "상태",
    "코드",
    "마지막 갱신",
    "범위",
    "비범위"
  ],
  "open_items": {
    "id": "open",
    "label": "미결",
    "type": "table",
    "columns": [
      "ID",
      "미결",
      "다음에 할 일"
    ]
  },
  "rules": [
    "empty_required_becomes_open_item",
    "no_fake_fill",
    "json_ephemeral_md_ssot"
  ]
}
